{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "SoloMD",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "visible": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "description": "Plain text document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "mmap"
        ],
        "name": "SoloMD Mindmap",
        "description": "SoloMD mind map",
        "role": "Editor",
        "mimeType": "application/x-solomd-mindmap"
      }
    ]
  }
}
